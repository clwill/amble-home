     BT_DBG("NetRecv, Src 0x%04x Dst 0x%04x Rssi %d NetIf %u",
         rx->ctx.addr, rx->ctx.recv_dst, rx->ctx.recv_rssi, net_if);
 
+    /* AMARAN: snoop fixture status replies before the normal (dst-gated)
