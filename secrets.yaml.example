# Copy to secrets.yaml (gitignored) and fill in. Never commit the real file.
# Used by amble-home.dev.yaml only; the release config (amble-home.yaml) has no secrets.
wifi_ssid: "your-network"
wifi_password: "your-password"
# Dev builds only: the mesh unicast address of the one spare fixture a dev board
# may command. Read it off the Edit page; it is user data, keep it here only.
spare_address: 0x0020
